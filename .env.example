# Connection string de Postgres nativo de Render (Dashboard > tu base >
# Connections > Internal/External Database URL). Opcional: si no esta
# configurada, la app funciona igual que hoy, sin persistencia (ver src/db.py).
DATABASE_URL=postgresql://user:password@host/db_name

# Contraseña compartida opcional para la app (ver app.py). Si no esta
# configurada, no bloquea a nadie.
APP_PASSWORD=
